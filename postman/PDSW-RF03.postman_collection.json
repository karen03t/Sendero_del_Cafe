          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 para OPERADOR', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 · Sin token no hay acceso",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/rutas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "rutas"
          ]
        },
        "description": ""
