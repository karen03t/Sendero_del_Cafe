{
  "info": {
    "name": "PDSW · RF-03 Rutas",
    "description": "RF-03 generar/personalizar/guardar rutas, RF-06 inactivar/recuperar y RF-04 sincronizacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "operadorCorreo",
      "value": "operador@sendero.co"
    },
    {
      "key": "operadorPassword",
      "value": "Operador2026*Segura"
    },
    {
      "key": "tokenOperador",
      "value": ""
    },
    {
      "key": "tokenTurista",
      "value": ""
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "rutaId",
      "value": ""
    },
    {
      "key": "paradas",
      "value": "[]"
    },
    {
      "key": "desde",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 · Login operador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Credenciales de demostracion: operadorCorreo/operadorPassword en variables de coleccion.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{operadorCorreo}}\",\n  \"password\": \"{{operadorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y token de operador', () => {",
              "  pm.response.to.have.status(200);",
              "  const b = pm.response.json();",
              "  pm.expect(b.rol).to.eql('OPERADOR');",
              "  pm.collectionVariables.set('tokenOperador', b.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 · Crear lugar A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperador}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lugares",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lugares"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Calle Real {{$timestamp}}\",\n  \"descripcion\": \"Lugar sembrado por la coleccion RF-03\",\n  \"categoria\": \"local\",\n  \"direccion\": \"Via principal\",\n  \"municipio\": \"Salento\",\n  \"latitud\": 4.637,\n  \"longitud\": -75.571\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y guarda el id', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('lugarA', pm.response.json().id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Crear lugar B",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperador}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lugares",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lugares"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mirador {{$timestamp}}\",\n  \"descripcion\": \"Lugar sembrado por la coleccion RF-03\",\n  \"categoria\": \"ecológico\",\n  \"direccion\": \"Via principal\",\n  \"municipio\": \"Salento\",\n  \"latitud\": 4.639,\n  \"longitud\": -75.569\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y guarda el id', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('lugarB', pm.response.json().id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Crear lugar C",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
