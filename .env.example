# Variables de entorno — copiar a .env y ajustar.
# El .env real nunca se sube al repositorio.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turismo_eje_cafetero
DB_USER=turismo_app
DB_PASS=cambia_esta_clave

# Mínimo 64 caracteres para HS512. Generar uno propio:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=genera_un_secreto_de_al_menos_64_caracteres_con_openssl_rand_base64_64

# Operador inicial (solo desarrollo). Si quedan vacías, no se crea ninguno.
OPERADOR_INICIAL_NOMBRE=
OPERADOR_INICIAL_CORREO=
OPERADOR_INICIAL_PASSWORD=
