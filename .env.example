# Variables de entorno — copiar a .env y ajustar
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turismo_eje_cafetero
DB_USER=turismo_app
DB_PASS=cambia_esta_clave
DB_ROOT_PASS=root_local
# Mínimo 32 caracteres (firma HS512 del JWT)
JWT_SECRET=cambia_este_secreto_de_al_menos_32_caracteres

operador.inicial.nombre=${OPERADOR_INICIAL_NOMBRE:}
operador.inicial.correo=${OPERADOR_INICIAL_CORREO:}
operador.inicial.password=${OPERADOR_INICIAL_PASSWORD:}